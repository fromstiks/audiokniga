<!--
  Палитра виджета. Он живёт в чужом процессе и раскрашивается ресурсами, а не темой
  Compose, поэтому цвета продублированы здесь. Ночной вариант лежит в values-night и
  подхватывается по настройке системы.

  Фон полупрозрачный: виджет лежит на обоях, и сплошная плашка смотрится наклейкой.
-->
<resources>
    <color name="widget_surface">#D9E7E3DA</color>
    <color name="widget_ink">#2B2924</color>
    <color name="widget_ink_muted">#726D62</color>
    <color name="widget_accent">#2F7370</color>
    <color name="widget_cover_top">#3C4A55</color>
    <color name="widget_cover_bottom">#2E4340</color>
</resources>
